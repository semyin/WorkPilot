# Build outputs and dependency caches. Keep Cargo.lock and package-lock.json.
/target/
node_modules/
dist/
.cache/
.vite/
/.npm/
*.tsbuildinfo

# Local app data, downloaded tools, test runs and coverage.
/.local/
/.workpilot-data/
/.test-results/
/test-results/
/playwright-report/
/blob-report/
coverage/
.nyc_output/
*.log
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Local credentials and signing keys. Sanitized example files may be committed.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.*.sample
!.env.template
!.env.*.template
/.secrets/
*.key
*.pem
*.p12
*.pfx

# Tauri generates schemas and copies sidecars here; retain the placeholder.
/apps/desktop/src-tauri/binaries/*
!/apps/desktop/src-tauri/binaries/.gitkeep
/apps/desktop/src-tauri/gen/

# Generated WorkPilot distributions stay local; retain instructions and evidence.
# Do not ignore the authored icons, research samples or source manifests.
/artifacts/workpilot-*/preview/*
!/artifacts/workpilot-*/preview/*.md
!/artifacts/workpilot-*/preview/*.txt
!/artifacts/workpilot-*/preview/.gitkeep
/artifacts/workpilot-*/tools/*
!/artifacts/workpilot-*/tools/*.md
!/artifacts/workpilot-*/tools/*.txt
!/artifacts/workpilot-*/tools/.gitkeep
/artifacts/workpilot-*/*.zip
/artifacts/workpilot-*/*.7z
/artifacts/workpilot-*/*.tar.gz
/artifacts/workpilot-*/*.tar.xz
/artifacts/workpilot-*/*.exe
/artifacts/workpilot-*/*.msi
/artifacts/workpilot-*/*.msix
/artifacts/workpilot-*/*.dmg
/artifacts/workpilot-*/*.pkg
/artifacts/workpilot-*/*.deb
/artifacts/workpilot-*/*.rpm
/artifacts/workpilot-*/*.AppImage

# Python caches and local virtual environments.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS and editor temporary files. Shared .vscode settings remain trackable.
.DS_Store
._*
Thumbs.db
Desktop.ini
.vs/
.idea/
*.suo
*.user
*.swp
*.swo
*~

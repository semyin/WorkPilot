{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkPilot",
  "version": "0.1.0-alpha.12.1",
  "identifier": "com.workpilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WorkPilot",
        "width": 1240,
        "height": 820,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false,
        "backgroundColor": "#F8F9FB"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; frame-src 'self' about:; object-src 'none'; base-uri 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/workpilot-sidecar"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    },
    "icon": [
      "../../../assets/icons/png/32.png",
      "../../../assets/icons/png/128.png",
      "../../../assets/icons/png/256.png",
      "../../../assets/icons/icon.icns",
      "../../../assets/icons/icon.ico"
    ]
  }
}

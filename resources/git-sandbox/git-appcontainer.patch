+			char saved;
+			cursor--;
+			if (!is_dir_sep(*cursor)) continue;
+			saved = *cursor;
+			*cursor = 0;
+			if (!stat(path, &parent) && S_ISDIR(parent.st_mode)) {
+				*cursor = saved;
+				next_component = cursor + 1;
+				break;
+			}
+			*cursor = saved;

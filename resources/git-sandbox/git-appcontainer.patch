+#ifdef _WIN32
+	/* Existing parents need traversal, not permission to inspect every ancestor.
+	 * Find the nearest accessible directory, then retain the original creation
+	 * and shared-permission checks for every component still missing. */
+	if (workpilot_is_appcontainer()) {
+		char *cursor = path + strlen(path);
+		while (cursor > next_component) {

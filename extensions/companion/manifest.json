{
  "manifest_version": 3,
  "name": "WorkPilot Browser Companion",
  "version": "0.8.0",
  "description": "Connect only the tabs you authorize to a WorkPilot task. Disconnect at any time.",
  "permissions": ["activeTab", "debugger", "nativeMessaging"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkPilot 浏览器连接"
  },
  "key": ""
}

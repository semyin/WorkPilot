{
  "manifest_version": 3,
  "name": "WorkPilot Browser Probe",
  "version": "0.1.1",
  "description": "P00 transport probe. Only operates on the WorkPilot local fixture page after a user click.",
  "permissions": ["activeTab", "debugger", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WorkPilot browser probe"
  },
  "key": ""
}
